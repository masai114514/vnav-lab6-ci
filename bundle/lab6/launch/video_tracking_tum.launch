<?xml version="1.0" encoding="UTF-8"?>
<!--
  TUM RGB-D（office.bag 的替代数据集）专用 launch。

  与 video_tracking.launch 的差别只有三处，都是"数据集不同"导致的：
    1) 相机内参从 Tesse 的 415.69/(360,240) 换成 TUM fr1 的 517.3/(318.6,255.3)，
       并把 TUM 的畸变系数传进去（fr1 有明显桶形畸变）；
    2) 深度是 16UC1、1 单位 = 1/5000 米，靠 depth_scale 换算；
    3) bag 的话题名与 odom 语义保持一致，因此 remap 不变。
  office.bag 上仍然用 video_tracking.launch（节点默认内参就是官方值）。
-->
<launch>
  <arg name="bag" default="$(eval env('HOME') + '/data/vnav/tum_office.bag')" />
  <arg name="pose_estimator" default="0" />
  <arg name="use_ransac" default="true" />
  <arg name="rate" default="1.0" />
  <arg name="max_frames" default="0" />
  <arg name="csv_path" default="" />
  <arg name="run_rviz" default="false" />
  <arg name="thr_bearing" default="1e-4" />
  <arg name="thr_3d" default="0.03" />

  <node name="lab_6" pkg="lab_6" type="pose_estimation" output="screen"
    args="--use_ransac=$(arg use_ransac)
    --pose_estimator=$(arg pose_estimator)
    --scale_translation=1
    --csv_path=$(arg csv_path)
    --max_frames=$(arg max_frames)
    --ransac_threshold_bearing=$(arg thr_bearing)
    --ransac_threshold_3d=$(arg thr_3d)">
    <param name="fx" value="517.306408" />
    <param name="fy" value="516.469215" />
    <param name="cx" value="318.643040" />
    <param name="cy" value="255.313989" />
    <rosparam param="dist">[0.262383, -0.953104, -0.005358, 0.002628, 1.163314]</rosparam>
    <param name="depth_scale" value="5000.0" />
    <param name="min_depth" value="0.3" />
    <param name="max_depth" value="8.0" />
    <remap from="/ground_truth_pose" to="/tesse/odom"/>
    <remap from="/rgb_images_topic" to="/tesse/left_cam/rgb/image_raw"/>
    <remap from="/depth_images_topic" to="/tesse/depth_cam/mono/image_raw"/>
  </node>

  <node if="$(arg run_rviz)" name="viz" pkg="rviz" type="rviz" args="-d $(find lab_6)/rviz/office.rviz" />

  <node name="rosbag" pkg="rosbag" type="play" output="screen" args="--clock -r $(arg rate) $(arg bag)"/>
</launch>

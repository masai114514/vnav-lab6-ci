<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <arg name="dataset" default="office.bag" />
  <arg name="path_to_dataset" default="$(eval env('HOME') + '/data/vnav/' + arg('dataset'))"/>
  <arg name="bag" default="$(arg path_to_dataset)" />

  <!-- 要跑哪个估计器：0=5pt 1=8pt 2=2pt 3=Arun -->
  <arg name="pose_estimator" default="0" />
  <arg name="use_ransac" default="true" />
  <arg name="rate" default="1.0" />
  <!-- 0 表示一直跑到 bag 结束；CI 里给个上限，免得节点挂住不退出 -->
  <arg name="max_frames" default="0" />
  <arg name="csv_path" default="" />
  <arg name="run_rviz" default="false" />
  <!-- RANSAC 阈值：2D-2D 用 1-cos(alpha)，3D-3D 用米 -->
  <arg name="thr_bearing" default="1e-4" />
  <arg name="thr_3d" default="0.03" />

  <node name="lab_6" pkg="lab_6" type="pose_estimation" output="screen">
    <!-- 参数走 ROS 私有参数，不用 gflags（原因见 pose_estimation.cpp 里 Options 的注释） -->
    <param name="pose_estimator" value="$(arg pose_estimator)" />
    <param name="use_ransac" value="$(arg use_ransac)" />
    <param name="scale_translation" value="true" />
    <param name="csv_path" value="$(arg csv_path)" />
    <param name="max_frames" value="$(arg max_frames)" />
    <param name="ransac_threshold_bearing" value="$(arg thr_bearing)" />
    <param name="ransac_threshold_3d" value="$(arg thr_3d)" />
    <remap from="/ground_truth_pose" to="/tesse/odom"/>
    <remap from="/rgb_images_topic" to="/tesse/left_cam/rgb/image_raw"/>
    <remap from="/depth_images_topic" to="/tesse/depth_cam/mono/image_raw"/>
  </node>

  <node if="$(arg run_rviz)" name="viz" pkg="rviz" type="rviz" args="-d $(find lab_6)/rviz/office.rviz" />

  <!-- Tip: press space on the terminal you ran this roslaunch to pause the rosbag-->
  <node name="rosbag" pkg="rosbag" type="play" output="screen" args="--clock -r $(arg rate) $(arg bag)"/>
</launch>
